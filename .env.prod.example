# Заготовка боевого окружения: cp .env.prod.example .env.prod
# Порядок — README, раздел «Развёрнутый стенд».

# ── домен и TLS ───────────────────────────────────────────────────
# Поддомен приложения; его A-запись указывает на IP сервера.
# С него идут мини-приложение MAX, кабинеты, API и вебхук бота.
# Основной домен (devcore.com.ru) приложению не нужен — он у владельца
# под своё. Без домена Let's Encrypt сертификат не выдаст.
DOMAIN=domovoy.example.ru

# ── база ──────────────────────────────────────────────────────────
POSTGRES_USER=domovoy
# Длинная случайная строка: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
POSTGRES_PASSWORD=
POSTGRES_DB=domovoy

# ── MAX ───────────────────────────────────────────────────────────
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=t545_hakaton_max_bot
MAX_API_BASE=https://platform-api.max.ru

# ── фронт ─────────────────────────────────────────────────────────
# Фронт раздаёт сам сервер с того же адреса, поэтому здесь один origin
ALLOWED_ORIGINS=https://domovoy.example.ru

# ── прочее ────────────────────────────────────────────────────────
# Та же команда, что для пароля базы
COOKIE_SECRET=
DEV_TOOLS=0

# Куда складывать вложения к обращениям. В контейнере это том domovoy_uploads.
UPLOADS_DIR=/data/uploads

# ── Бот MAX и Домовёнок: ИИ-агент ──────────────────────────────────────────
# Секрет вебхука (5–256 символов: латиница, цифры, дефис). Пусто — вебхук выключен.
BOT_WEBHOOK_SECRET=
# Сколько сообщений жителя в сутки идут в модель
BOT_DAILY_MESSAGES=30
# Ключ авторизации GigaChat из личного кабинета (не Client Secret!).
# Пусто — Домовёнок без модели: опасность, шаблоны кода, жалоба словами человека.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модель Домовёнка-агента. Pro — по прогону bot:agent-eval (30.09.2026) заметно
# точнее Lite: сам оформляет жалобы, не путает темы. GigaChat-2 — это Lite.
GIGACHAT_MODEL=GigaChat-2-Pro
# Пусто — https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_API_BASE=
GIGACHAT_CONCURRENCY=1
# Потолок токенов в сутки на весь бот: разбор и агент, все шаги (~1–1,5 тыс. на вопрос)
GIGACHAT_DAILY_TOKENS=800000
# Сертификат Минцифры: положите файл в certs/ до prod:up — Dockerfile встроит его в образ
