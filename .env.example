# Заготовка окружения разработки: cp .env.example .env.local

# ── MAX ───────────────────────────────────────────────────────────
# Токен бота выдаёт @MasterBot. Можно оставить пустым: без него не работает
# только вход через мессенджер.
MAX_BOT_TOKEN=
MAX_BOT_USERNAME=t545_hakaton_max_bot
MAX_BOT_USER_ID=422472764
MAX_API_BASE=https://platform-api.max.ru

# ── База ──────────────────────────────────────────────────────────
# Локальный контейнер из docker-compose.yml. Порт 5433, а не 5432:
# на 5432 часто сидит системная служба Postgres.
DATABASE_URL=postgresql://domovoy:domovoy@localhost:5433/domovoy
# Отдельная база тестов: они делают TRUNCATE всех таблиц.
TEST_DATABASE_URL=postgresql://domovoy:domovoy@localhost:5433/domovoy_test

# ── Фронт ─────────────────────────────────────────────────────────
# Чужие origin, которым можно звать API. localhost разрешён всегда,
# на бою фронт раздаёт сам сервер с того же адреса — обычно пусто.
ALLOWED_ORIGINS=

# ── Прочее ────────────────────────────────────────────────────────
# Ручной ввод строки QR на экране входа (только вне продакшена)
DEV_TOOLS=1
# Читаемые логи. Здесь, а не префиксом в npm-скрипте: «VAR=1 node ...»
# не работает на Windows.
PRETTY_LOGS=1
PORT=3000

# ── Бот MAX и Домовёнок: ИИ-агент ──────────────────────────────────────────
# Секрет вебхука (5–256 символов: латиница, цифры, дефис). Пусто — вебхук выключен.
BOT_WEBHOOK_SECRET=
# Сколько сообщений жителя в сутки идут в модель
BOT_DAILY_MESSAGES=30
# Ключ авторизации GigaChat из личного кабинета (не Client Secret!).
# Пусто — Домовёнок без модели: опасность, шаблоны кода, жалоба словами человека.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
# Модель Домовёнка-агента. Pro — по прогону bot:agent-eval (30.09.2026) заметно
# точнее Lite: сам оформляет жалобы, не путает темы. GigaChat-2 — это Lite.
GIGACHAT_MODEL=GigaChat-2-Pro
# Пусто — https://gigachat.devices.sberbank.ru/api/v1
GIGACHAT_API_BASE=
GIGACHAT_CONCURRENCY=1
# Потолок токенов в сутки на весь бот: разбор и агент, все шаги (~1–1,5 тыс. на вопрос)
GIGACHAT_DAILY_TOKENS=800000
# Корневой сертификат Минцифры (https://gu-st.ru/content/lending/russian_trusted_root_ca_pem.crt)
GIGACHAT_CA_FILE=certs/russian_trusted_root_ca.crt
