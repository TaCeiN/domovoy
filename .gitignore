# ── секреты ─────────────────────────────────────────────────────
# .env.local и .env.prod: токен бота MAX, пароль боевой базы, COOKIE_SECRET.
# В репозиторий идут только заготовки *.example.
.env
.env.*
!.env.example
!.env.prod.example
# Корневой сертификат для Bot API кладётся руками (см. Dockerfile)
certs/

# ── зависимости ─────────────────────────────────────────────────
node_modules/

# ── данные жителей ──────────────────────────────────────────────
# Вложения к обращениям и фотографии объявлений (UPLOADS_DIR)
uploads/
var/

# ── тяжёлое и восстановимое ─────────────────────────────────────
# Старое место выжимки OSM; теперь она качается в var/datasets/osm/ (dataset:build)
tools/receipt-generator/data/*.osm.pbf
# Дампы баз и снимки папки
backups/
*.tgz
*.dump
*.sql.gz

# ── мусор инструментов ──────────────────────────────────────────
*.log
npm-debug.log*
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
