{
  "name": "domovoy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test --test-concurrency=1 --env-file-if-exists=.env.local \"lib/**/*.test.ts\" \"server/**/*.test.ts\"",
    "db:generate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:push": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs push",
    "db:studio": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs studio",
    "db:setup": "node --env-file-if-exists=.env.local db/setup.ts",
    "db:migrate": "node --env-file-if-exists=.env.local db/migrate.ts",
    "db:reset": "node --env-file-if-exists=.env.local db/migrate.ts --reset",
    "db:clear": "node --env-file-if-exists=.env.local db/clear.ts",
    "dev": "node --watch --env-file-if-exists=.env.local server/index.ts",
    "start": "node --env-file-if-exists=.env.local server/index.ts",
    "typecheck": "tsc --noEmit",
    "check:front": "node scripts/check-front.mjs",
    "vendor:zxing": "node scripts/vendor-zxing.mjs",
    "receipts": "node --env-file-if-exists=.env.local tools/receipt-generator/server.mjs",
    "receipts:prod": "node scripts/prod.mjs receipts",
    "demo:reset": "node --env-file-if-exists=.env.local db/demo.ts reset",
    "demo:clear": "node --env-file-if-exists=.env.local db/demo.ts clear",
    "demo:on": "node --env-file-if-exists=.env.local db/demo.ts on",
    "demo:off": "node --env-file-if-exists=.env.local db/demo.ts off",
    "prod:demo": "node scripts/prod.mjs demo",
    "test:tools": "node --test tools/**/*.test.mjs",
    "check": "npm run typecheck && npm run check:front && npm test",
    "dataset:build": "node --max-old-space-size=8192 db/dataset-build.ts",
    "dataset:load": "node --env-file-if-exists=.env.local db/dataset-load.ts",
    "dataset:publish": "node db/dataset-publish.ts",
    "mock:load": "node --env-file-if-exists=.env.local db/mock-load.ts",
    "mock:clear": "node --env-file-if-exists=.env.local db/mock-load.ts --clear",
    "uk:find": "node --env-file-if-exists=.env.local db/dispatcher-add.ts",
    "uk:dispatcher": "node --env-file-if-exists=.env.local db/dispatcher-add.ts",
    "admin:add": "node --env-file-if-exists=.env.local db/admin-add.ts",
    "house:claims": "node --env-file-if-exists=.env.local db/house-admin.ts claims",
    "house:form": "node --env-file-if-exists=.env.local db/house-admin.ts form",
    "house:org": "node --env-file-if-exists=.env.local db/house-admin.ts org",
    "house:chairman": "node --env-file-if-exists=.env.local db/house-admin.ts chairman",
    "house:chairman:revoke": "node --env-file-if-exists=.env.local db/house-admin.ts chairman-revoke",
    "house:residents": "node --env-file-if-exists=.env.local db/house-admin.ts residents",
    "prod": "node scripts/prod.mjs",
    "prod:up": "node scripts/prod.mjs up",
    "prod:down": "node scripts/prod.mjs down",
    "prod:restart": "node scripts/prod.mjs restart",
    "prod:ps": "node scripts/prod.mjs ps",
    "prod:logs": "node scripts/prod.mjs logs",
    "prod:health": "node scripts/prod.mjs health",
    "prod:studio": "node scripts/prod.mjs studio",
    "prod:migrate": "node scripts/prod.mjs migrate",
    "prod:clear": "node scripts/prod.mjs clear",
    "prod:uk": "node scripts/prod.mjs uk",
    "prod:admin": "node scripts/prod.mjs admin",
    "prod:dataset": "node scripts/prod.mjs dataset",
    "prod:mock": "node scripts/prod.mjs mock",
    "prod:bot-test": "node scripts/prod.mjs bot-test",
    "prod:bot": "node scripts/prod.mjs bot",
    "bot:poll": "node --env-file-if-exists=.env.local db/bot.ts poll",
    "bot:eval": "node --env-file-if-exists=.env.local db/bot.ts eval",
    "bot:agent-eval": "node --env-file-if-exists=.env.local db/bot.ts eval-agent"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "jsqr": "^1.4.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "leaflet": "^1.9.4",
    "pbf": "^5.1.2",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2",
    "yaml": "^2.9.1",
    "zxing-wasm": "^3.1.3"
  },
  "engines": {
    "node": ">=22"
  }
}
